# Firebase Functions Secrets (Set via 'firebase functions:secrets:set NAME')
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Environment Variables (Set via .env files or Cloud Functions Console)
LINE_ADMIN_GROUP_ID=your_group_id_here
GOOGLE_SHEET_ID=your_google_sheet_id_here

# LIFF Settings (For liff-app/.env)
VITE_LIFF_ID=your_liff_id_here
